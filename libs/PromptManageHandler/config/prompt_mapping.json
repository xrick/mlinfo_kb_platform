    },
    "FUNNEL_START": {
      "primary_prompt": "recept_guest_prompt1", 
      "fallback_prompt": "mgfd_principal_prompt",
      "description": "開始漏斗對話，引導用戶"
    },
    "FUNNEL_QUESTION": {
      "primary_prompt": "mgfd_collect_slot_value_prompt_v1",
      "fallback_prompt": "mgfd_principal_prompt",
      "description": "收集用戶需求信息的問答階段"
    },
    "RECOMMENDATION_PREPARATION": {
      "primary_prompt": "mgfd_principal_prompt",
      "fallback_prompt": "sales_prompt4",
      "description": "準備產品推薦"
    },
    "RECOMMENDATION_PRESENTATION": {
      "primary_prompt": "sales_prompt4",
      "fallback_prompt": "mgfd_principal_prompt",
      "description": "展示產品推薦結果"
    },
    "PRODUCT_QA": {
      "primary_prompt": "sales_prompt4",
      "fallback_prompt": "mgfd_principal_prompt", 
      "description": "回答產品相關問題"
    },
    "ELICITATION": {
      "primary_prompt": "mgfd_collect_slot_value_prompt_v1",
      "fallback_prompt": "mgfd_principal_prompt",
      "description": "需求澄清階段"
    },
    "PURCHASE_GUIDANCE": {
      "primary_prompt": "sales_prompt4",
      "fallback_prompt": "mgfd_principal_prompt",
