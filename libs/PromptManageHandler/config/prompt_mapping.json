    },
    "END": {
      "primary_prompt": "mgfd_principal_prompt",
      "fallback_prompt": "recept_guest_prompt1",
      "description": "對話結束"
    },
    "ERROR": {
      "primary_prompt": "mgfd_principal_prompt",
      "fallback_prompt": "recept_guest_prompt1",
      "description": "錯誤處理"
    }
