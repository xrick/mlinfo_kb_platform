{
  "description": "提示管理系統默認設置",
  "version": "1.0.0",
  "last_updated": "2025-01-01",
  "system_settings": {
    "enable_cache": true,
    "auto_reload": true,
    "strict_mode": false,
    "cache_expiry_hours": 24,
    "max_cache_size": 1000
  },
  "selection_settings": {
    "default_strategy": "hybrid",
    "default_language": "zh-TW",
    "confidence_threshold": 0.5,
    "max_alternatives": 5,
    "enable_round_robin": false
  },
  "rendering_settings": {
    "enable_render_cache": true,
    "render_cache_max_size": 500,
    "strict_variable_checking": false,
    "allow_html_in_variables": false,
    "max_template_size_kb": 100
  },
  "registry_settings": {
    "prompts_base_dir": "HumanData/PromptsHub",
    "supported_extensions": [".txt", ".md", ".json"],
    "scan_subdirectories": true,
    "watch_file_changes": true,
    "metadata_file_suffix": ".metadata.json"
  },
  "performance_settings": {
    "preload_high_priority_prompts": true,
    "min_priority_for_preload": 8,
    "async_processing": true,
    "batch_operations": true,
    "enable_metrics": true
  },
  "fallback_prompts": {
    "system_error": "mgfd_principal_prompt",
    "template_not_found": "mgfd_principal_prompt",
    "rendering_error": "recept_guest_prompt1",
    "selection_failure": "mgfd_principal_prompt"
  },
  "variable_defaults": {
    "product_data": "產品資料:無",
    "query": "",
    "answer": "",
    "prompt_using": "",
    "user_name": "用戶",
    "system_name": "MGFD 筆電助手",
    "company_name": "您的公司"
  },
  "logging_settings": {
    "log_level": "INFO",
    "log_selection_details": true,
    "log_render_performance": false,
    "log_cache_hits": false,
    "max_log_entries": 10000
  },
  "security_settings": {
    "sanitize_user_input": true,
    "escape_html_in_output": false,
    "allowed_variable_functions": [
      "len", "str", "int", "float", "bool",
      "upper", "lower", "title", "strip",
      "replace", "format"
    ],
    "max_variable_nesting_level": 5,
    "max_loop_iterations": 100
  },
  "integration_settings": {
    "enable_state_machine_integration": true,
    "state_change_triggers_reload": false,
    "auto_select_on_state_change": true,
    "preserve_context_across_states": true
  },
  "monitoring_settings": {
    "track_usage_stats": true,
    "track_performance_metrics": true,
    "alert_on_high_error_rate": true,
    "error_rate_threshold": 0.1,
    "health_check_interval_minutes": 5
  },
  "notes": [
    "所有設置都可以通過環境變量或配置文件覆蓋",
    "strict_mode=true 時，缺失變數會導致渲染失敗",
    "cache_expiry_hours=0 表示禁用緩存過期",
    "confidence_threshold 用於過濾低置信度的提示選擇",
    "preload_high_priority_prompts 可提升高頻提示的響應速度"
  ]
}